# ==============================================================================
# AUDIT DESK / CA AUDIT CHATBOT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this to .env locally or paste these keys into Vercel Project Settings > Environment Variables
# ==============================================================================

# --- LLM & AI PROVIDER CONFIGURATION ---
# Note for Vercel: Vercel serverless runs in the cloud. Local Ollama (127.0.0.1) cannot be accessed
# from Vercel unless you use a public tunnel/URL. For cloud deployment on Vercel, set LLM_PROVIDER=gemini.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# (Optional: Local / Self-hosted Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- SUPABASE (POSTGRES & PGVECTOR) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key

# --- GOOGLE CALENDAR & MEET INTEGRATION ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_CALENDAR_ID=primary
AUDITOR_MEET_LINK=https://meet.google.com/your-default-meet-link

# --- LEAD AUDITOR & CA PROFILE ---
AUDITOR_NAME=CA Keerthiga Sri J.M.
AUDITOR_FIRM=J.M. & Associates Chartered Accountants
AUDITOR_REG_NO=FCA-084920
AUDITOR_DESIGNATION=Senior Statutory Auditor & Tax Consultant
AUDITOR_EMAIL=keerthigasri04@gmail.com
AUDITOR_PHONE=+91 98765 43210
AUDITOR_OFFICE_ADDRESS=Chennai, Tamil Nadu, India
AUDITOR_SPECIALIZATION=Statutory Audit, Tax Compliance, 10-Year Financial Due Diligence
TIMEZONE=Asia/Kolkata

# --- EMAIL / SMTP (CALENDAR INVITES & NOTIFICATIONS) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# --- SECURITY & ACCESS CONTROL ---
APP_PASSWORD=your_dashboard_access_password
API_KEY=your_secret_api_key_for_rest_endpoints
CORS_ORIGIN=*
